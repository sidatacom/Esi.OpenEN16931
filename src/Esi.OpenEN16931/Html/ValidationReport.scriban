<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Validation report</title>
    <style>
        body { font-family: Calibri, Arial, sans-serif; margin: 2rem; color: #202124; max-width: 1100px; }
        h1 { margin-bottom: 0.5rem; }
        h2 { margin-top: 1.5rem; }
        .important { font-weight: 700; background: #e0e0e0; padding: 0.6rem; }
        .valid { color: #137333; }
        .invalid, .error { color: #b3261e; }
        .metadata dt { float: left; clear: left; width: 220px; font-weight: 700; }
        .metadata dd { margin-left: 240px; }
        table { border-collapse: collapse; width: 100%; margin: 0.75rem 0 1.25rem; }
        th { background: #f0f0f0; text-align: left; }
        th, td { border: 1px solid #c8c8c8; padding: 0.35rem; vertical-align: top; }
        tr.warning { color: #735c00; }
        tr.information { color: #37474f; }
        .position { white-space: pre-wrap; word-break: break-word; }
    </style>
</head>
<body>
    <h1>Validation report</h1>
    <div class="important {{ if Report.IsValid }}valid{{ else }}invalid{{ end }}">
        Conformance: {{ if Report.IsValid }}The document is formally compliant.{{ else }}The document is not formally compliant.{{ end }}
    </div>
    <div class="metadata">
        <p class="important">Document details</p>
        <dl>
            <dt>Reference:</dt><dd>{{ Report.DocumentReference ?? "not available" }}</dd>
            <dt>Validation time:</dt><dd>{{ Report.Timestamp }}</dd>
            <dt>Document type:</dt><dd>{{ Report.DocumentType ?? "unknown" }}</dd>
            <dt>Validator:</dt><dd>{{ Report.EngineName }}</dd>
        </dl>
    </div>
    <h2>Validation overview</h2>
    <table>
        <thead><tr><th>Validation step</th><th>Errors</th><th>Warnings</th><th>Information</th></tr></thead>
        <tbody>
        {{ for step in Report.Steps }}
            <tr><td>{{ step.Name }} ({{ step.Id }})</td><td>{{ step.ErrorCount }}</td><td>{{ step.WarningCount }}</td><td>{{ step.InformationCount }}</td></tr>
        {{ end }}
        </tbody>
    </table>
    <h2>Validation details</h2>
    <table>
        <thead><tr><th>Position</th><th>Code</th><th>Level</th><th>Text</th></tr></thead>
        <tbody>
        {{ for step in Report.Steps }}
            {{ for message in step.Messages }}
            <tr class="{{ message.Level }}"><td>{{ message.Id }}<br><span class="position">{{ message.XPathLocation }}</span></td><td>{{ message.Code }}</td><td>{{ message.Level }}</td><td>{{ message.Text }}</td></tr>
            {{ end }}
        {{ end }}
        </tbody>
    </table>
    <div class="important {{ if Report.IsValid }}valid{{ else }}invalid{{ end }}">Assessment: {{ Report.Recommendation }}</div>
    <p>Generated by {{ Report.EngineName }}.</p>
</body>
</html>